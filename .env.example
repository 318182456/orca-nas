# Only bind to a private LAN/Tailscale address. No public port forwarding.
BIND_IP=192.168.3.12
ORCA_PORT=6768
ORCA_PAIRING_ADDRESS=192.168.3.12
PUID=1026
PGID=100
ORCA_VERSION=1.4.277
ORCA_SHA256=cc0be421b6dc995e74c855db21d7f6c428ed759419d6a494c8ad08773812ea29
ORCA_IMAGE=ghcr.io/318182456/orca-nas:stable

# Optional Traefik. NAS deployments may select their existing shared preset.
TRAEFIK_PRESET_FILE=./compose-presets.yml
TRAEFIK_ENABLE=false
TRAEFIK_SUBDOMAIN=orca
TRAEFIK_CONTAINER_PORT=6768
TRAEFIK_DOMAIN=example.invalid
TRAEFIK_HTTPS_PORT=8443
